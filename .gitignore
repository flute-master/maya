# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Maya memory (auto-saved on this device)
/data/maya-memory.json
/data/maya-gpt.pt
/data/maya-gpt-meta.json
/data/train-corpus.txt
/data/train-status.json
/data/train.log
__pycache__/
*.pyc
/data/maya-vectors.json
/data/workspace/**
!/data/workspace/.gitkeep
/data/google-*.json
/public/maya.zip

