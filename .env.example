# Optional. You can also paste these in Customize → Lookup.
# Never commit the real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Service account key for desktop testing. Prefer dropping the JSON on Desktop
# as maya-google-service-account.json, or set a path. Do not commit the key.
# GOOGLE_SERVICE_ACCOUNT_FILE=/mnt/c/Users/You/Desktop/maya-google-service-account.json
# WINDOWS_USERNAME=You
